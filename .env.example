# Copy to .env and fill in the values. Never commit .env: it is gitignored, so
# it does not arrive with a clone, and on a worker host the operator places it
# by hand (skills/worker-host/SKILL.md).
#
# Read by `scripts/worker-credentials.sh forge-cli`, which authenticates glab
# and gh from it, and sourced into every worker session from ~/.bashrc. Both
# CLIs are API-layer only - git traffic rides the SSH keys that `keys` and
# `keys-install` set up - so these tokens cover MR/PR work and nothing else.

# gl.wallarm.com personal access token, scope `api`: MR create, view, merge.
GITLAB_TOKEN=

# GitHub personal access token, for toolset PRs. Absent is not an error, and a
# worker delivering only GitLab work never needs one. `gh auth login
# --with-token` gives its minimum as `repo`, `read:org` and `gist`.
GITHUB_TOKEN=
