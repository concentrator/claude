# Copy to .env and fill in the values. Never commit .env: it is gitignored, so
# it does not arrive with a clone, and on a worker host the operator places it
# by hand (skills/worker-host/SKILL.md).
#
# Read by `scripts/worker-credentials.sh forge-cli`, which authenticates glab
# and gh from it, and sourced into every worker session from ~/.bashrc. Both
# CLIs are API-layer only - git traffic rides the SSH keys that `keys` and
# `keys-install` set up - so these tokens cover MR/PR work and nothing else.

# Git identity for commits made on this host. The author is the human whose
# work it is; the committer is set from the hostname to `<host> (supervised)`,
# because every commit here is supervised delivery and the two fields are what
# git provides for that distinction. Both are required: without an identity git
# refuses to commit, so a worker halts at its first commit rather than writing
# a misattributed one.
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitLab instance the token below is for; gl.wallarm.com when empty. forge-cli
# logs glab in to it, and every worker session exports it, which pins the
# host for glab calls made outside a checkout.
GITLAB_HOST=

# Personal access token for that instance, scope `api`: MR create, view, merge.
GITLAB_TOKEN=

# GitHub personal access token, for toolset PRs. Absent is not an error, and a
# worker delivering only GitLab work never needs one. `gh auth login
# --with-token` gives its minimum as `repo`, `read:org` and `gist`.
GITHUB_TOKEN=
