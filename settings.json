{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(glab mr view:*)",
      "Bash(mkdir:*)",
      "Bash(chmod +x:*)",
      "Bash(bash -n:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git commit-tree:*)",
      "Bash(git config:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git grep:*)",
      "Bash(git init:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge:*)",
      "Bash(git merge-base:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git show-ref:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh release:*)",
      "Bash(make:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(terraform:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "Bash(claude plugin:*)",
      "Skill(update-config)",
      "WebSearch",
      "WebFetch(domain:docs.wallarm.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:developer.hashicorp.com)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-branch-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-secrets-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-branch-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-secrets-guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-branch-state.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dev-precompact-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{ts: (now | strftime(\"%Y-%m-%dT%H:%M:%SZ\")), skill: .tool_input.skill}' >> ~/.claude/skill_invocations.jsonl 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "includeCoAuthoredBy": false,
  "autoCompactWindow": 200000,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "isolatePeerMachines": true
}
